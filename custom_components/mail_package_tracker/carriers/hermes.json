{
  "schema_version": 1,
  "id": "hermes",
  "name": "Hermes",
  "icon": "mdi:package-variant-closed",
  "language": "de",
  "enabled": true,
  "sender_patterns": [
    "myhermes.de",
    "hermesworld.com",
    "hermes-world.com",
    "hermes.de"
  ],
  "subject_patterns": [
    "hermes sendung",
    "hermes paket"
  ],
  "exclude_patterns": [
    "newsletter"
  ],
  "ordered_patterns": [],
  "in_transit_patterns": [
    "ist unterwegs",
    "auf dem weg",
    "angekündigt",
    "sendungsstatus"
  ],
  "out_for_delivery_patterns": [
    "in zustellung",
    "kommt heute",
    "heute zugestellt",
    "zustellung heute"
  ],
  "delivered_patterns": [
    "wurde zugestellt",
    "erfolgreich zugestellt",
    "im paketshop",
    "abholbereit"
  ],
  "tomorrow_patterns": [
    "kommt morgen",
    "voraussichtlich morgen"
  ],
  "tracking_regex": "(H[0-9]{19}|[0-9]{14})",
  "tracking_url_regex": "(https://[^\\s\\\"'<]+myhermes\\.de/[^\\s\\\"'<]*)",
  "default_tracking_url": "https://www.myhermes.de/empfangen/sendungsverfolgung/suchen/sendungsinformation/{tracking_id}",
  "content_regex": "(?:Sendung von|von)\\s+([^\\n\\r\\\"<>]+)"
}
