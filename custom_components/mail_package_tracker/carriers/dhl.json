    "dhl sendung"
  ],
  "exclude_patterns": [
    "newsletter",
    "werbung",
    "kundenbefragung"
  ],
  "ordered_patterns": [],
  "in_transit_patterns": [
    "paketankündigung",
    "ist unterwegs",
