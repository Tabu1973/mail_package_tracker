{
  "schema_version": 1,
  "id": "dhl",
  "name": "DHL",
  "icon": "mdi:truck-delivery",
  "language": "de",
  "enabled": true,
  "sender_patterns": [
    "dhl.de",
    "dhl.com",
    "deutschepost.de",
    "paket.de",
    "dpdhl.com"
  ],
  "subject_patterns": [
    "dhl paket",
    "dhl sendung"
  ],
  "exclude_patterns": [
    "newsletter",
    "werbung",
    "kundenbefragung"
  ],
  "ordered_patterns": [],
  "in_transit_patterns": [
    "paketankündigung",
    "ist unterwegs",
    "auf dem weg",
    "wurde versandt",
    "in kürze",
    "kommt am"
  ],
  "out_for_delivery_patterns": [
    "in zustellung",
    "kommt heute",
    "wird heute zugestellt",
    "zustellung heute",
    "heute zwischen",
    "zur auslieferung"
  ],
  "delivered_patterns": [
    "wurde zugestellt",
    "erfolgreich zugestellt",
    "haben wir zugestellt",
    "liegt in der packstation",
    "abholbereit",
    "wurde geliefert",
    "am wunschort",
    "am ablageort"
  ],
  "tomorrow_patterns": [
    "kommt morgen",
    "voraussichtlich morgen",
    "zustellung morgen",
    "lieferung morgen"
  ],
  "tracking_regex": "(0034[0-9]{16}|[0-9]{12,20}|JJD[0-9]{10,20})",
  "tracking_url_regex": "(https://[^\\s\\\"'<]+dhl\\.[a-z.]+/[^\\s\\\"'<]*)",
  "default_tracking_url": "https://www.dhl.de/de/privatkunden/pakete-empfangen/verfolgen.html?piececode={tracking_id}",
  "content_regex": "(?:Sendung von|Paket von)\\s+([A-Za-z0-9ÄÖÜäöüß &._-]{2,35}?)(?:\\s+(?:mit|ist|wird|kommt|wurde|an|in|[0-9]{8})|[,.!\\n\\r\\\"<>]|$)"
}
