    "wurde versandt",
    "in kürze",
    "kommt am",
    "verzögert sich",
    "verzögerung",
    "verzögerungen",
    "neuer voraussichtlicher zustelltag",
    "neuer zustelltag",
    "neuer liefertermin",
    "zustelltag ist",
    "auf dem transportweg"
  ],
  "out_for_delivery_patterns": [
    "in zustellung",
    "kommt heute",
    "wird heute zugestellt",
    "zustellung heute",
    "heute zwischen",
    "zur auslieferung"
  ],
  "delivered_patterns": [
