{
  "schema_version": 1,
  "id": "ups",
  "name": "UPS",
  "icon": "mdi:truck-fast",
  "language": "de",
  "enabled": true,
  "sender_patterns": [
    "ups.com"
  ],
  "subject_patterns": [
    "ups sendung",
    "ups zustellung",
    "ups update"
  ],
  "exclude_patterns": [
    "newsletter",
    "rechnung",
    "emails.ups.com",
    "werbung",
    "vorschriften"
  ],
  "ordered_patterns": [],
  "in_transit_patterns": [
    "unterwegs",
    "geplante zustellung"
  ],
  "out_for_delivery_patterns": [
    "in zustellung",
    "wird heute zugestellt",
    "zustellung heute",
    "heute bis",
    "heute im laufe des tages"
  ],
  "delivered_patterns": [
    "wurde zugestellt",
    "zugestellt",
    "hat ihr paket zugestellt"
  ],
  "tomorrow_patterns": [
    "wird morgen zugestellt",
    "zustellung morgen",
    "morgen im laufe des tages"
  ],
  "tracking_regex": "(1Z[A-Z0-9]{16})",
  "tracking_url_regex": "(https://[^\\s\\\"'<]+ups\\.com/[^\\s\\\"'<]*)",
  "default_tracking_url": "https://www.ups.com/track?loc=de_DE&tracknum={tracking_id}",
  "content_regex": ""
}