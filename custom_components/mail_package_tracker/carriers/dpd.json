{
  "schema_version": 1,
  "id": "dpd",
  "name": "DPD",
  "icon": "mdi:cube-send",
  "language": "de",
  "enabled": true,
  "sender_patterns": [
    "dpd.de",
    "dpd.com",
    "dpdgroup.com"
  ],
  "subject_patterns": [
    "dpd paket",
    "ihr dpd"
  ],
  "exclude_patterns": [
    "newsletter",
    "bewertung"
  ],
  "ordered_patterns": [],
  "in_transit_patterns": [
    "baldige zustellung",
    "ist unterwegs",
    "auf dem weg",
    "paketankündigung"
  ],
  "out_for_delivery_patterns": [
    "heute zugestellt",
    "kommt heute",
    "in zustellung",
    "zustellung heute"
  ],
  "delivered_patterns": [
    "wurde zugestellt",
    "erfolgreich zugestellt",
    "abgestellt",
    "im pickup paketshop",
    "abholbereit"
  ],
  "tomorrow_patterns": [
    "kommt morgen",
    "zustellung morgen",
    "morgen zwischen"
  ],
  "tracking_regex": "([0-9]{14})",
  "tracking_url_regex": "(https://[^\\s\\\"'<]+dpd\\.[a-z.]+/[^\\s\\\"'<]*)",
  "default_tracking_url": "https://tracking.dpd.de/status/de_DE/parcel/{tracking_id}",
  "content_regex": "(?:Sendung von|Paket von)\\s+([A-Za-z0-9ÄÖÜäöüß &._-]{2,35}?)(?:\\s+(?:mit|ist|wird|kommt|wurde|an|in|[0-9]{8})|[,.!\\n\\r\\\"<>]|$)"
}
