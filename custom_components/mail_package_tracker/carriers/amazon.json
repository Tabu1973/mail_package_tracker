{
  "schema_version": 1,
  "id": "amazon",
  "name": "Amazon",
  "icon": "mdi:cart",
  "languages": [
    "de",
    "en"
  ],
  "enabled": true,
  "sender_patterns": [
    "amazon.de",
    "amazon.com",
    "amazon.eu",
    "amazon.co.uk"
  ],
  "subject_patterns": [],
  "exclude_patterns": [
    "customer-reviews",
    "amazonmusic",
    "audible",
    "kindle",
    "prime video",
    "storniert",
    "gutschrift",
    "rücksendung",
    "ersatzlieferung",
    "cancelled",
    "refund"
  ],
  "ordered_patterns": [
    "bestellt:",
    "bestellbestätigung",
    "vielen dank für deine bestellung",
    "vielen dank für ihre bestellung",
    "order confirmation",
    "ordered:",
    "thank you for your order"
  ],
  "in_transit_patterns": [
    "versendet:",
    "dein paket wurde versendet",
    "wurde versandt",
    "wurde versendet",
    "unterwegs",
    "shipped:",
    "your package has shipped",
    "dispatched:"
  ],
  "out_for_delivery_patterns": [
    "in zustellung:",
    "ankunft heute",
    "kommt heute",
    "wird heute zugestellt",
    "wird heute geliefert",
    "zustellung heute",
    "heute bis",
    "out for delivery:",
    "arriving today"
  ],
  "delivered_patterns": [
    "geliefert:",
    "zugestellt:",
    "wurde geliefert",
    "wurde zugestellt",
    "erfolgreich zugestellt",
    "wurde an ",
    "wurde übergeben",
    "liegt am ablageort",
    "delivered:",
    "has been delivered"
  ],
  "tomorrow_patterns": [
    "ankunft morgen",
    "lieferung morgen",
    "lieferung: morgen",
    "zustellung morgen",
    "wird morgen",
    "kommt morgen",
    "arriving tomorrow"
  ],
  "tracking_regex": "Bestellnr., Order #, shipmentId=",
  "tracking_url_regex": "(https://[^\\s\\\"'<]+amazon\\.[a-z.]+/(?:progress-tracker|gp/your-account|gp/css/shiptrack)[^\\s\\\"'<]*)",
  "default_tracking_url": "https://www.amazon.de/gp/your-account/order-history",
  "content_regex": "*"
}
