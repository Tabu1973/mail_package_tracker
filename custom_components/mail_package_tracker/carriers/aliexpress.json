{
  "schema_version": 1,
  "id": "aliexpress",
  "name": "AliExpress",
  "icon": "mdi:shopping",
  "language": "de",
  "enabled": true,
  "sender_patterns": [
    "aliexpress.com"
  ],
  "subject_patterns": [
    "aliexpress",
    "goodcang",
    "parel"
  ],
  "exclude_patterns": [
    "promotion",
    "sale",
    "rabatt"
  ],
  "ordered_patterns": [
    "zahlung bestätigt",
    "bestellung bestätigt"
  ],
  "in_transit_patterns": [
    "wurde versandt",
    "unterwegs",
    "im zielland angekommen"
  ],
  "out_for_delivery_patterns": [
    "in zustellung",
    "zur auslieferung bereit"
  ],
  "delivered_patterns": [
    "wurde zugestellt",
    "wurde geliefert",
    "erfolgreich zugestellt"
  ],
  "tomorrow_patterns": [
    "morgen"
  ],
  "tracking_regex": "(0034[0-9]{16}|[A-Z]{2}[0-9]{9}[A-Z]{2}|[0-9]{12,16})",
  "tracking_url_regex": "(https://[^\\s\\\"'<]+(?:aliexpress\\.com|cainiao\\.com|dhl\\.de)[^\\s\\\"'<]*)",
  "default_tracking_url": "https://www.aliexpress.com/p/order/index.html",
  "content_regex": "Bestellung\\s+([0-9]+)"
}
