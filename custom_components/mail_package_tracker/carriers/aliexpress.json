{
  "schema_version": 1,
  "id": "aliexpress",
  "name": "AliExpress",
  "icon": "mdi:shopping",
  "language": "de",
  "enabled": true,
  "sender_patterns": [
    "aliexpress.com"
  ],
  "subject_patterns": [
    "aliexpress",
    "goodcang",
    "parel"
  ],
  "exclude_patterns": [
    "promotion",
    "sale",
    "rabatt",
    "mail.aliexpress.com",
    "ae-yy-notify",
    "aeug-preferences",
    "ae-week-digest"
  ],
  "ordered_patterns": [
    "zahlung bestätigt",
    "bestellung bestätigt"
  ],
  "in_transit_patterns": [
    "wurde versandt",
    "unterwegs",
    "im zielland angekommen",
    "vom kurier abgeholt",
    "auf bestätigung wird gewartet",
    "wird auf bestellung versendet",
    "auf dem weg"
  ],
  "out_for_delivery_patterns": [
    "in zustellung",
    "zur auslieferung bereit"
  ],
  "delivered_patterns": [
    "wurde zugestellt",
    "wurde geliefert",
    "erfolgreich zugestellt"
  ],
  "tomorrow_patterns": [
    "morgen"
  ],
  "tracking_regex": "Packstück[:\\s#]*(0034[0-9]{16}|[A-Z0-9]{10,22})|Paket[:\\s#]*(0034[0-9]{16})|(0034[0-9]{16})|([A-Z]{2}[0-9]{9}[A-Z]{2})|Bestellung[:\\s#]*([0-9]{12,18})",
  "tracking_url_regex": "(https://[^\\s\\\"'<]+(?:aliexpress\\.com|cainiao\\.com|dhl\\.de)[^\\s\\\"'<]*)",
  "default_tracking_url": "https://www.aliexpress.com/p/order/index.html",
  "content_regex": "Paketinfos(?:\\s*\\n\\s*\\.)*\\s*\\n\\s*((?!\\.+\\s*$)[^\\n\\r]{4,120})|Empfang bestätigen(?:\\s*\\n\\s*\\.)*\\s*\\n\\s*((?!\\.+\\s*$)[^\\n\\r]{4,120})|(?:^|\\n)((?!\\.+\\s*$)[^\\n\\r]{5,120})\\r?\\n(?:\\s*\\r?\\n)?(?!\\.+\\s*$)[^\\n\\r]{2,100}\\r?\\n(?:\\s*\\r?\\n)?x[0-9]+\\b"
}
